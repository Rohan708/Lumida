# Copy to .env and fill in. .env is git-ignored; never commit real values.
# App settings use the LUMIDA_ prefix (see src/lumida/config.py).

# --- Local Postgres (docker-compose.yml reads these) -----------------------
POSTGRES_USER=aide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aide
POSTGRES_PORT=5432

# --- Metadata store ----------------------------------------------------------
# SQLAlchemy URL, psycopg v3 driver. Must match the POSTGRES_* values above.
LUMIDA_DATABASE_URL=postgresql+psycopg://aide:change-me@localhost:5432/aide

# DEBUG | INFO | WARNING | ERROR
LUMIDA_LOG_LEVEL=INFO

# --- Test lab (Stage 1.2): a separate Postgres acting as "the customer's database" ---
LAB_POSTGRES_USER=lab
LAB_POSTGRES_PASSWORD=change-me-too
LAB_POSTGRES_DB=shopco
LAB_POSTGRES_PORT=5433
LUMIDA_LAB_DATABASE_URL=postgresql+psycopg://lab:change-me-too@localhost:5433/shopco

# --- Customer databases -----------------------------------------------------
# One URL per data source, under any name you like; `lumida source add NAME --kind KIND
# --connection-ref THAT_NAME` stores only the name. Formats and read-only logins per
# database: docs/setup/databases.md. Examples (uncomment and fill in):
# SHOPDB_URL=mysql+pymysql://aide:<password>@db-host:3306/shopdb
# SHOP_MSSQL_URL=mssql+pyodbc://aide:<password>@db-host:1433/shopdb?driver=ODBC+Driver+18+for+SQL+Server&ApplicationIntent=ReadOnly
# SHOP_ORACLE_URL=oracle+oracledb://aide:<password>@db-host:1521/?service_name=SHOPPDB
# JAFFLE_SF_URL=snowflake://AIDE_SVC@<account>/JAFFLE_DB?warehouse=AIDE_WH&role=AIDE_READONLY&private_key_file=<path to .p8>

# --- Alerting ------------------------------------------------------------------
LUMIDA_SLACK_WEBHOOK_URL=

# --- AI features: your own provider and key (optional; off by default) ---------------
# Only structure and statistics are sent (no row values); checks never use the AI.
#   openai = any OpenAI-compatible service: OpenAI, OpenRouter, Groq, Mistral, Together,
#            Azure OpenAI, ... or a model on your own machines (Ollama, LM Studio, vLLM)
#   gemini = Google Gemini
#   none   = AI features off
LUMIDA_LLM_PROVIDER=none
LUMIDA_LLM_MODEL=
LUMIDA_LLM_API_KEY=
# For openai: where the service is. Empty = https://api.openai.com/v1.
#   Ollama on this machine:    http://localhost:11434/v1   (from Docker: http://host.docker.internal:11434/v1)
#   LM Studio:                 http://localhost:1234/v1
LUMIDA_LLM_BASE_URL=
LUMIDA_LLM_TIMEOUT_SECONDS=120

# --- Offline mode --------------------------------------------------------------------
# true = never connect anywhere except your own databases: no Slack, no AI service.
LUMIDA_OFFLINE=false

# --- Self-hosted service (`lumida serve`, Stage 4.1) ---------------------------------
# How often the scheduler checks which sources are due (seconds).
LUMIDA_SCHEDULER_TICK_SECONDS=60
# How soon "Run now" and other jobs from the web app start (seconds).
LUMIDA_JOB_POLL_SECONDS=2
# Health endpoint (GET /healthz). 127.0.0.1 = only inside the container; 0 = off.
LUMIDA_HEALTH_HOST=127.0.0.1
LUMIDA_HEALTH_PORT=8080
# text | json (for log collectors)
LUMIDA_LOG_FORMAT=text

# --- API (Stage 4.2; `lumida serve` or `lumida api`) ---------------------------------
# People log in with email + password (create them with `lumida user add`); scripts use
# personal API keys. Docs at http://127.0.0.1:8000/api/docs
LUMIDA_API_ENABLED=true
LUMIDA_API_HOST=127.0.0.1
LUMIDA_API_PORT=8000
# Accounts (Stage 4.3): how long a login lasts; lockout after wrong passwords in a row.
LUMIDA_SESSION_HOURS=12
LUMIDA_LOGIN_MAX_FAILURES=5
LUMIDA_LOGIN_LOCKOUT_MINUTES=15
